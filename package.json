{
  "name": "dockyard-harness",
  "version": "1.0.0",
  "description": "Dockyard Harness: Autonomous Multi-Provider Agentic AI Harness with Hierarchical Planning, RL Trajectory Recorder, and DPO Exporter",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli && npm run build -w @dockyard/desktop",
    "build:core": "tsc -b packages/core packages/cli",
    "pretest": "tsc -b packages/core packages/cli",
    "test": "npm run --workspaces --if-present test",
    "typecheck": "tsc -b packages/core packages/cli && tsc -p packages/desktop --noEmit",
    "dev:desktop": "npm run dev -w @dockyard/desktop",
    "app": "node packages/cli/dist/bin.js app"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
