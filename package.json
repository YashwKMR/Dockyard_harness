{
  "name": "dockyard-harness",
  "version": "1.0.0",
  "description": "Dockyard Harness: Autonomous Multi-Provider Agentic AI Harness with Hierarchical Planning, RL Trajectory Recorder, and DPO Exporter",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run --workspaces --if-present test",
    "lint": "eslint . --ext .ts,.tsx 2>/dev/null || true",
    "typecheck": "tsc --build packages/core packages/cli"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
